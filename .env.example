# Copy to .env and adjust as required. All settings are optional.

# Directory holding the SQLite database and downloaded models.
# YV_DATA_DIR=./data

# Use another database, for example PostgreSQL (install the backend with the "postgres" extra).
# YV_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/your_voice

# Address the web application listens on.
# YV_HOST=127.0.0.1
# YV_PORT=8100

# Hugging Face access token for gated or private repositories.
# YV_HF_TOKEN=hf_xxx

# Host that managed runtimes bind to and are reached on.
# YV_RUNTIME_HOST=127.0.0.1

# Agent limits.
# YV_AGENT_MAX_ITERATIONS=60
# YV_TOOL_OUTPUT_LIMIT=20000

# Largest output document, in characters.
# YV_DOCUMENT_CHARACTER_LIMIT=200000
